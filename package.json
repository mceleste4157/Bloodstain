{
  "name": "bpa-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bloodstain Pattern Analysis Assistant — forensic documentation, measurement, and visualization platform.",
  "scripts": {
    "predev": "node scripts/gen-changelog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-changelog.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "konva": "^9.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.0.3"
  }
}
