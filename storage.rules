rules_version = '2';

// Evidence photos are stored under photos/{uid}/{caseId}/{photoId}. Only the
// owning user (the uid in the path) may read or write their files — no
// cross-user or anonymous access. Uploads are limited to images under 15 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{uid}/{caseId}/{photoId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (request.resource == null
                       || (request.resource.size < 15 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
